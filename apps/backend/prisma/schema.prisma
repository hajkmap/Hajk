generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model LocalAccount {
  id       String    @id @default(cuid())
  userId   String    @unique
  email    String    @unique
  password String
  fullName String
  expires  DateTime?
  user     User      @relation(fields: [userId], references: [id])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  fullName     String
  strategy     AuthStrategy
  localAccount LocalAccount?
  roles        RoleOnUser[]
}

model Role {
  id                  String                @id @default(cuid())
  code                String                @unique
  title               String?
  description         String?
  systemCriticalRole  Boolean               @default(false)
  users               RoleOnUser[]
  RoleOnMap           RoleOnMap[]
  RoleOnDisplayLayer  RoleOnDisplayLayer[]
  RoleOnSearchLayer   RoleOnSearchLayer[]
  RoleOnEditingLayer  RoleOnEditingLayer[]
  RoleOnLayerInstance RoleOnLayerInstance[]
  RoleOnToolInstance  RoleOnToolInstance[]
  RoleOnGroup         RoleOnGroup[]
}

model RoleOnUser {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RoleOnMap {
  mapId  Int
  roleId String
  map    Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([mapId, roleId])
}

model RoleOnDisplayLayer {
  displayLayerId String
  roleId         String?
  displayLayer   DisplayLayer @relation(fields: [displayLayerId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([displayLayerId])
}

model RoleOnSearchLayer {
  searchLayerId String
  roleId        String?
  searchLayer   SearchLayer @relation(fields: [searchLayerId], references: [id], onDelete: Cascade)
  role          Role?       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([searchLayerId])
}

model RoleOnEditingLayer {
  editingLayerId String
  roleId         String?
  editingLayer   EditingLayer @relation(fields: [editingLayerId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([editingLayerId])
}

model RoleOnLayerInstance {
  layerInstanceId String
  roleId          String
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  layerInstance   LayerInstance @relation(fields: [layerInstanceId], references: [id], onDelete: Cascade)

  @@id([layerInstanceId, roleId])
}

model RoleOnToolInstance {
  toolInstanceId Int          @map("toolId")
  roleId         String
  toolInstance   ToolInstance @relation(fields: [toolInstanceId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([toolInstanceId, roleId])
  @@map("RoleOnTool")
}

model RoleOnGroup {
  groupId String
  roleId  String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([groupId, roleId])
}

model Map {
  id                Int                 @id @default(autoincrement())
  locked            Boolean             @default(false)
  name              String              @unique
  options           Json                @default("{}")
  projectionId      Int?
  createdBy         String?
  createdDate       DateTime?           @db.Timestamptz(3) // Timestamp when created
  lastSavedBy       String?
  lastSavedDate     DateTime?           @db.Timestamptz(3) // Timestamp when last saved
  /// Raised by every save of the layer tree. A save names the version it was
  /// made from and is refused when the tree has been saved since.
  treeVersion       Int                 @default(0)
  deletedAt         DateTime?           @db.Timestamptz(3)
  projection        Projection?         @relation("MapViewProjection", fields: [projectionId], references: [id])
  projections       Projection[]        @relation("MapProjections")
  tools             ToolsOnMaps[]
  /// Background layers, and the search and editing layers the map uses.
  layers            LayerInstance[]
  restrictedToRoles RoleOnMap[]
  themes            Theme[]
  /// Top level of the map's layer tree.
  treeItems         MapTreeItem[]
  /// The map's exceptions to groups, and its draw order.
  groupExceptions   MapGroupException[]
  drawOrderItems    MapDrawOrderItem[]
  /// The map's settings for the groups and layers in its tree.
  groupSettings     MapGroupSetting[]
  layerSettings     MapLayerSetting[]
}

/// Map theme preset for quick-access layer configurations.
model Theme {
  id            Int       @id @default(autoincrement())
  mapName       String
  title         String
  owner         String?
  description   String?
  keywords      String[]  @default([])
  /// Imported JSON payload (layers, metadata, etc.)
  data          Json      @default("{}")
  createdBy     String?
  createdDate   DateTime? @db.Timestamptz(3)
  lastSavedBy   String?
  lastSavedDate DateTime? @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)
  map           Map       @relation(fields: [mapName], references: [name], onDelete: Cascade)

  @@index([mapName])
}

/// A folder owned by a DocumentHandler ToolInstance that groups documents.
model DocumentFolder {
  id             Int          @id @default(autoincrement())
  /// URL-safe slug derived from title at creation time. Immutable.
  name           String
  /// Human-readable display name.
  title          String
  toolInstanceId Int          @map("toolId")
  createdBy      String?
  createdDate    DateTime?    @db.Timestamptz(3)
  lastSavedBy    String?
  lastSavedDate  DateTime?    @db.Timestamptz(3)
  toolInstance   ToolInstance @relation(fields: [toolInstanceId], references: [id], onDelete: Cascade)
  documents      Document[]

  @@unique([toolInstanceId, name])
}

/// A document belonging to a DocumentHandler ToolInstance and folder. Content is stored as JSON.
model Document {
  id             Int            @id @default(autoincrement())
  /// URL-safe slug derived from title at creation time. Immutable.
  name           String
  /// Human-readable display name.
  title          String
  /// Chapter tree content: { chapters: [...] }
  content        Json           @default("{\"chapters\":[]}")
  toolInstanceId Int            @map("toolId")
  folderId       Int
  createdBy      String?
  createdDate    DateTime?      @db.Timestamptz(3)
  lastSavedBy    String?
  lastSavedDate  DateTime?      @db.Timestamptz(3)
  toolInstance   ToolInstance   @relation(fields: [toolInstanceId], references: [id], onDelete: Cascade)
  folder         DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Restrict)

  @@unique([toolInstanceId, folderId, name])
}

/// A plugin the client knows how to render (search, draw, documenthandler, ...).
/// Describes what a tool is; configuration lives on ToolInstance.
model ToolType {
  type        String         @id
  title       String
  description String?
  instances   ToolInstance[]
}

/// A configured instance of a ToolType. Several instances of the same type can
/// exist, e.g. "Dokument Bygglov" and "Dokument Detaljplaner", and one instance
/// can be used on many maps through ToolsOnMaps.
model ToolInstance {
  id                Int                  @id @default(autoincrement())
  locked            Boolean              @default(false)
  type              String
  /// Instance name, distinguishes instances of the same type
  title             String?
  /// Default options for this instance. ToolsOnMaps.options overrides them per map.
  options           Json                 @default("{}")
  createdBy         String?
  createdDate       DateTime?            @db.Timestamptz(3) // Timestamp when created
  lastSavedBy       String?
  lastSavedDate     DateTime?            @db.Timestamptz(3) // Timestamp when last saved
  /// Soft delete - set instead of removing the row
  deletedAt         DateTime?            @db.Timestamptz(3)
  toolType          ToolType             @relation(fields: [type], references: [type])
  maps              ToolsOnMaps[]
  restrictedToRoles RoleOnToolInstance[]
  documentFolders   DocumentFolder[]
  documents         Document[]
}

/// A ToolInstance placed on a map. `toolId` and `tool` refer to the ToolInstance.
model ToolsOnMaps {
  mapName String
  toolId  Int
  /// Whether the tool is enabled on the map. Inactive tools keep their row (and
  /// placement) so they can be re-enabled without losing configuration.
  active  Boolean      @default(true)
  /// Determines the sort between tools within a zone
  index   Int          @default(0)
  /// Placement zone in the map UI: drawer | widgetLeft | widgetRight | controlButton. Null means unplaced (managed via admin UI).
  target  String?
  /// Overrides ToolInstance.options for this map only
  options Json         @default("{}")
  map     Map          @relation(fields: [mapName], references: [name])
  tool    ToolInstance @relation(fields: [toolId], references: [id])

  @@id([mapName, toolId])
}

model Projection {
  id         Int       @id @default(autoincrement())
  locked     Boolean   @default(false)
  code       String    @unique
  definition String
  extent     Decimal[] @default([])
  units      String?
  mapView    Map[]     @relation("MapViewProjection")
  maps       Map[]     @relation("MapProjections")
  service    Service[]
}

model Group {
  id                String              @id @default(cuid())
  locked            Boolean             @default(false)
  name              String
  internalName      String?
  type              GroupType           @default(Layer)
  createdBy         String?
  createdDate       DateTime?           @db.Timestamptz(3) // Timestamp when created
  lastSavedBy       String?
  lastSavedDate     DateTime?           @db.Timestamptz(3) // Timestamp when last saved
  /// Raised by every save of the group's tree. A save names the version it was
  /// made from and is refused when the tree has been saved since.
  treeVersion       Int                 @default(0)
  deletedAt         DateTime?           @db.Timestamptz(3)
  /// A search group's layers. A layer group's content is in `items`.
  layers            LayerInstance[]
  restrictedToRoles RoleOnGroup[]
  /// The group's own content, in order.
  items             GroupItem[]         @relation("GroupItems")
  /// Places where this group is linked into another group.
  parentItems       GroupItem[]         @relation("GroupItemChild")
  /// Maps that have this group on their tree's top level.
  mapTreeItems      MapTreeItem[]
  /// What maps put in or hide in this group, and where maps put this group
  /// in another one or hide it there.
  mapExceptions     MapGroupException[] @relation("MapGroupExceptionGroup")
  inMapExceptions   MapGroupException[] @relation("MapGroupExceptionChild")
  /// What this group puts in the groups linked in its tree, what other groups
  /// put in this one, and where this group is put that way.
  nestedItems       GroupNestedItem[]   @relation("GroupNestedItemOwner")
  nestedIn          GroupNestedItem[]   @relation("GroupNestedItemGroup")
  nestedAs          GroupNestedItem[]   @relation("GroupNestedItemChild")
  /// Maps' settings for this group and for the layers in it.
  mapSettings       MapGroupSetting[]
  mapLayerSettings  MapLayerSetting[]
}

model Service {
  /// Primary key; stable reference for layers and APIs. Multiple services may share the same `url`.
  id              String         @id @default(cuid())
  metadataId      String?        @unique
  projectionId    Int?
  name            String
  locked          Boolean        @default(false)
  url             String
  version         String         @default("1.3.0")
  imageFormat     String         @default("image/png")
  type            ServiceType
  serverType      ServerType     @default(GEOSERVER)
  projection      Projection?    @relation(fields: [projectionId], references: [id])
  workspace       String?
  getMapUrl       String?
  comment         String?
  createdBy       String?
  createdDate     DateTime?      @db.Timestamptz(3)
  lastSavedBy     String?
  lastSavedDate   DateTime?      @db.Timestamptz(3)
  healthStatus    String?
  healthCheckedAt DateTime?      @db.Timestamptz(3)
  deletedAt       DateTime?      @db.Timestamptz(3)
  displayLayers   DisplayLayer[]
  searchLayers    SearchLayer[]
  editingLayers   EditingLayer[]
  metadata        Metadata?      @relation(fields: [metadataId], references: [id])
}

model Metadata {
  id           String        @id @default(cuid())
  title        String?
  description  String?
  owner        String?
  url          String?
  urlTitle     String?
  urlOpenData  String?
  attribution  String?
  created      DateTime      @default(now())
  updated      DateTime      @updatedAt
  service      Service?
  displayLayer DisplayLayer?
  searchLayer  SearchLayer?
}

model InfoClickSettings {
  id              String        @id @default(cuid())
  layerInstanceId String?
  definition      String?
  icon            String?
  format          String        @default("application/json")
  sortProperty    String?
  sortMethod      String        @default("text") // number or text
  sortDescending  Boolean       @default(false)
  displayLayer    DisplayLayer?
}

enum SearchOutputFormat {
  GML2
  GML3
  GML32
}

/// Map visualization layer (WMS, WMTS, ARCGIS, VECTOR, etc.).
model DisplayLayer {
  id                          String               @id @default(cuid())
  serviceId                   String
  metadataId                  String?              @unique
  infoClickSettingsId         String?              @unique
  selectedLayers              String[]             @default([])
  locked                      Boolean              @default(false)
  name                        String
  internalName                String?
  description                 String?
  service                     Service              @relation(fields: [serviceId], references: [id])
  metadata                    Metadata?            @relation(fields: [metadataId], references: [id])
  infoClickSettings           InfoClickSettings?   @relation(fields: [infoClickSettingsId], references: [id])
  opacity                     Float                @default(1)
  maxZoom                     Int                  @default(-1)
  minZoom                     Int                  @default(-1)
  minMaxZoomAlertOnToggleOnly Boolean              @default(false)
  tiled                       Boolean              @default(false)
  singleTile                  Boolean              @default(false)
  hidpi                       Boolean              @default(false)
  legendOptions               String?
  legendUrl                   String?
  legendIconUrl               String?
  style                       String?
  customRatio                 Int                  @default(0)
  showMetadata                Boolean              @default(false)
  infoClickActive             Boolean              @default(true)
  timeSliderVisible           Boolean              @default(false)
  timeSliderStart             String?
  timeSliderEnd               String?
  hideExpandArrow             Boolean              @default(false)
  zIndex                      Int                  @default(0)
  createdBy                   String?
  createdDate                 DateTime?            @db.Timestamptz(3)
  lastSavedBy                 String?
  lastSavedDate               DateTime?            @db.Timestamptz(3)
  deletedAt                   DateTime?            @db.Timestamptz(3)
  restrictedToRoles           RoleOnDisplayLayer[]
  instances                   LayerInstance[]
  options                     Json                 @default("{}")
  /// Groups and map trees this layer is placed in.
  groupItems                  GroupItem[]
  groupNestedItems            GroupNestedItem[]
  mapTreeItems                MapTreeItem[]
  mapGroupExceptions          MapGroupException[]
  mapDrawOrderItems           MapDrawOrderItem[]
  mapLayerSettings            MapLayerSetting[]

  @@index([serviceId])
}

/// Search layer configuration (independent of service type; WFS is common).
model SearchLayer {
  id                     String              @id @default(cuid())
  serviceId              String
  metadataId             String?             @unique
  selectedLayers         String[]            @default([])
  locked                 Boolean             @default(false)
  name                   String
  internalName           String?
  description            String?
  service                Service             @relation(fields: [serviceId], references: [id])
  metadata               Metadata?           @relation(fields: [metadataId], references: [id])
  active                 Boolean             @default(false)
  url                    String?
  searchFields           String[]            @default([])
  primaryDisplayFields   String[]            @default([])
  secondaryDisplayFields String[]            @default([])
  shortDisplayFields     String[]            @default([])
  outputFormat           SearchOutputFormat  @default(GML3)
  geometryField          String?
  infobox                String?
  aliasDict              String?
  zIndex                 Int                 @default(0)
  createdBy              String?
  createdDate            DateTime?           @db.Timestamptz(3)
  lastSavedBy            String?
  lastSavedDate          DateTime?           @db.Timestamptz(3)
  deletedAt              DateTime?           @db.Timestamptz(3)
  restrictedToRoles      RoleOnSearchLayer[]
  instances              LayerInstance[]
  options                Json                @default("{}")

  @@index([serviceId])
}

/// Editing layer configuration (WFST and similar).
model EditingLayer {
  id                String               @id @default(cuid())
  serviceId         String
  selectedLayers    String[]             @default([])
  locked            Boolean              @default(false)
  name              String
  internalName      String?
  description       String?
  service           Service              @relation(fields: [serviceId], references: [id])
  geometryField     String?
  createdBy         String?
  createdDate       DateTime?            @db.Timestamptz(3)
  lastSavedBy       String?
  lastSavedDate     DateTime?            @db.Timestamptz(3)
  deletedAt         DateTime?            @db.Timestamptz(3)
  restrictedToRoles RoleOnEditingLayer[]
  instances         LayerInstance[]
  options           Json                 @default("{}")

  @@index([serviceId])
}

/// A layer placed directly on a map: a background layer (BACKGROUND), or a
/// search or editing layer the map uses; or a search layer in a search group
/// (groupId). Display layers in a map's foreground come from its layer tree
/// (MapTreeItem, GroupItem and the map's exceptions), not from here.
model LayerInstance {
  id                String                @id @default(cuid())
  displayLayerId    String?
  searchLayerId     String?
  editingLayerId    String?
  mapId             Int?
  groupId           String?
  displayLayer      DisplayLayer?         @relation(fields: [displayLayerId], references: [id])
  searchLayer       SearchLayer?          @relation(fields: [searchLayerId], references: [id])
  editingLayer      EditingLayer?         @relation(fields: [editingLayerId], references: [id])
  map               Map?                  @relation(fields: [mapId], references: [id])
  group             Group?                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// BACKGROUND for a map's background layers; search and editing layers have none.
  usage             UseType?
  restrictedToRoles RoleOnLayerInstance[]
  infoClickActive   Boolean               @default(true)
  visibleAtStart    Boolean               @default(false)
  zIndex            Int                   @default(0)
  options           Json                  @default("{}")

  @@index([displayLayerId])
  @@index([searchLayerId])
  @@index([editingLayerId])
}

/// A group's content in order. Each row is either a layer
/// or another group, linked by reference so changes to that group show up
/// everywhere it is used. A group with child groups is a layer tree.
model GroupItem {
  id             String        @id @default(cuid())
  groupId        String
  index          Int           @default(0)
  displayLayerId String?
  childGroupId   String?
  group          Group         @relation("GroupItems", fields: [groupId], references: [id], onDelete: Cascade)
  displayLayer   DisplayLayer? @relation(fields: [displayLayerId], references: [id], onDelete: Cascade)
  childGroup     Group?        @relation("GroupItemChild", fields: [childGroupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([childGroupId])
}

/// Part of a group's own tree: a layer or a group it puts
/// inside a group linked in its tree. The linked group itself stays as it is;
/// the placement shows wherever the owner is used.
model GroupNestedItem {
  id             String        @id @default(cuid())
  /// The group whose tree this belongs to.
  ownerGroupId   String
  /// The linked group the item is put in.
  groupId        String
  index          Int           @default(0)
  displayLayerId String?
  childGroupId   String?
  /// The item it comes after ("layer:<id>" or "group:<id>"); null puts it
  /// first. If that item is gone, it goes last.
  afterKey       String?
  owner          Group         @relation("GroupNestedItemOwner", fields: [ownerGroupId], references: [id], onDelete: Cascade)
  group          Group         @relation("GroupNestedItemGroup", fields: [groupId], references: [id], onDelete: Cascade)
  displayLayer   DisplayLayer? @relation(fields: [displayLayerId], references: [id], onDelete: Cascade)
  childGroup     Group?        @relation("GroupNestedItemChild", fields: [childGroupId], references: [id], onDelete: Cascade)

  @@index([ownerGroupId])
  @@index([groupId])
}

/// The top level of a map's layer tree, in order. Each row
/// is either a layer or a linked group. Kept apart from the layerswitcher tool.
model MapTreeItem {
  id             String        @id @default(cuid())
  mapName        String
  index          Int           @default(0)
  displayLayerId String?
  groupId        String?
  map            Map           @relation(fields: [mapName], references: [name], onDelete: Cascade, onUpdate: Cascade)
  displayLayer   DisplayLayer? @relation(fields: [displayLayerId], references: [id], onDelete: Cascade)
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([mapName])
}

/// A map's own exception to a group it shows. ADD puts a
/// layer or a group in the group on this map only; HIDE leaves out something
/// the group shows on this map. The group itself stays as it is.
model MapGroupException {
  id             String                @id @default(cuid())
  mapName        String
  groupId        String
  kind           MapGroupExceptionKind
  /// Order the exceptions are applied in (an ADD can come after another ADD).
  index          Int                   @default(0)
  displayLayerId String?
  childGroupId   String?
  /// ADD: the item it comes after ("layer:<id>" or "group:<id>"); null puts
  /// it first. If that item is gone, it goes last.
  afterKey       String?
  map            Map                   @relation(fields: [mapName], references: [name], onDelete: Cascade, onUpdate: Cascade)
  group          Group                 @relation("MapGroupExceptionGroup", fields: [groupId], references: [id], onDelete: Cascade)
  displayLayer   DisplayLayer?         @relation(fields: [displayLayerId], references: [id], onDelete: Cascade)
  childGroup     Group?                @relation("MapGroupExceptionChild", fields: [childGroupId], references: [id], onDelete: Cascade)

  @@index([mapName])
  @@index([groupId])
}

enum MapGroupExceptionKind {
  ADD
  HIDE
}

/// A map's draw order, top first, set apart from its tree.
model MapDrawOrderItem {
  id             String       @id @default(cuid())
  mapName        String
  displayLayerId String
  index          Int
  map            Map          @relation(fields: [mapName], references: [name], onDelete: Cascade, onUpdate: Cascade)
  displayLayer   DisplayLayer @relation(fields: [displayLayerId], references: [id], onDelete: Cascade)

  @@unique([mapName, displayLayerId])
}

/// A map's own settings for a group in its tree, the same
/// wherever the group shows on the map. Only settings that differ from the
/// defaults are stored; without a row the defaults apply.
model MapGroupSetting {
  id                    String  @id @default(cuid())
  mapName               String
  groupId               String
  /// The group's name on this map; null shows the group's own name.
  name                  String?
  toggled               Boolean @default(false)
  expanded              Boolean @default(false)
  exclusive             Boolean @default(false)
  infoGroupVisible      Boolean @default(false)
  infoGroupTitle        String  @default("")
  infoGroupText         String  @default("")
  infoGroupUrl          String  @default("")
  infoGroupUrlText      String  @default("")
  infoGroupOpenDataLink String  @default("")
  infoGroupOwner        String  @default("")
  map                   Map     @relation(fields: [mapName], references: [name], onDelete: Cascade, onUpdate: Cascade)
  group                 Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([mapName, groupId])
}

/// A map's own settings for a layer in a group of its tree.
/// Only settings that differ from the defaults are stored.
model MapLayerSetting {
  id             String       @id @default(cuid())
  mapName        String
  /// The group the layer shows in.
  groupId        String
  displayLayerId String
  visibleAtStart Boolean      @default(false)
  infobox        String       @default("")
  map            Map          @relation(fields: [mapName], references: [name], onDelete: Cascade, onUpdate: Cascade)
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  displayLayer   DisplayLayer @relation(fields: [displayLayerId], references: [id], onDelete: Cascade)

  @@unique([mapName, groupId, displayLayerId])
}

enum ServiceType {
  ARCGIS
  VECTOR
  WFS
  WFST
  WMS
  WMTS
}

enum ServerType {
  QGIS_SERVER
  GEOSERVER
}

enum UseType {
  BACKGROUND
  FOREGROUND
}

enum AuthStrategy {
  LOCAL
  AZURE_AD
  GITHUB
}

enum GroupType {
  Layer
  Search
}
