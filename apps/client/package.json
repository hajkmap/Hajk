{
  "name": "hajk-client",
  "version": "4.4.0",
  "description": "Hajk Client UI",
  "homepage": "https://github.com/hajkmap/Hajk/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hajkmap/Hajk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "vite dev",
    "dev": "vite dev",
    "build": "tsc && vite build",
    "build-preview": "vite build && vite preview",
    "prestart": "node prebuild.js",
    "prebuild": "node prebuild.js",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "i18n:extract": "i18next-cli extract && node scripts/i18n-plugins.mjs extract && npm run i18n:types",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status && node scripts/i18n-plugins.mjs status",
    "i18n:types": "node scripts/i18n-plugins.mjs merge-types && i18next-cli types && prettier --write --log-level warn src/types/resources.d.ts",
    "i18n:sv-check": "node scripts/sv-check.mjs --summary",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.26.5",
    "@eslint/js": "^10",
    "@types/load-google-maps-api": "^2.0.5",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "i18next-cli": "1.79.1",
    "prettier": "^3.8.3",
    "prop-types": "^15.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "6.1.1"
  },
  "dependencies": {
    "@barbapapazes/plausible-tracker": "^0.5.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/material-icons": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "@libpdf/core": "^0.2.11",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/system": "^9.0.1",
    "@mui/utils": "^9.0.1",
    "@mui/x-data-grid": "^9.3.0",
    "@nieuwlandgeo/sldreader": "^0.7.3",
    "@turf/buffer": "^7.3.5",
    "@turf/difference": "^7.3.2",
    "@turf/helpers": "^7.3.2",
    "@turf/kinks": "^7.3.1",
    "@turf/line-intersect": "^7.3.2",
    "@turf/line-split": "^7.3.2",
    "@turf/transform-translate": "^7.3.5",
    "@turf/union": "^7.3.5",
    "altcha": "^3.3.0",
    "file-saver": "^2.0.5",
    "i18next": "26.5.4",
    "intro.js": "^7.2.0",
    "intro.js-react": "^1.0.0",
    "jszip": "^3.10.1",
    "load-google-maps-api": "^2.0.2",
    "motion": "^12.38.0",
    "notistack": "^3.0.2",
    "ol": "^10.9.0",
    "ol-mapbox-style": "^13.4.3",
    "proj4": "^2.20.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.7",
    "react-event-observer": "^0.5.11",
    "react-horizontal-scrolling-menu": "^8.2.0",
    "react-i18next": "17.1.0",
    "react-markdown": "^10.1.0",
    "react-modal-sheet": "^5.6.0",
    "react-number-format": "^5.4.5",
    "react-rnd": "^10.5.3",
    "react-scroll": "^1.9.3",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.0",
    "x2js": "^3.4.5",
    "xlsx": "^0.18.5"
  }
}
