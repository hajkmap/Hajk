# Copy to .env and set your own values. Never commit .env.

# Image tag of ghcr.io/hajkmap/hajk, such as nightly or develop. See docs/releases.md.
HAJK_TAG=nightly

POSTGRES_PASSWORD=
GEOSERVER_ADMIN_PASSWORD=

# Keycloak's admin console, http://localhost:8180, user "admin".
KEYCLOAK_ADMIN_PASSWORD=
# Password for the example users in keycloak/hajk-realm.json.
DEMO_USER_PASSWORD=
# Shared by Keycloak and oauth2-proxy. Create with: openssl rand -hex 32
OIDC_CLIENT_SECRET=
# Encrypts the session cookie. Must be 32 characters: openssl rand -hex 16
OAUTH2_PROXY_COOKIE_SECRET=
